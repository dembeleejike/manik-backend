# Copy this file to .env and fill in real values. Never commit the real .env file.

# MongoDB Atlas connection string (from your cluster's "Connect" button)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/manik

# Any long random string — used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# From your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail address to SEND notification emails from, plus an App Password
# (not your normal Gmail password — generate one at myaccount.google.com/apppasswords)
EMAIL_USER=
EMAIL_APP_PASSWORD=

# The business owner's real inbox — where quote notifications actually land
OWNER_EMAIL=

PORT=5000

# Copy this file to .env and fill in real values. Never commit the real .env file.

# MongoDB Atlas connection string (from your cluster's "Connect" button)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/manik

# Any long random string — used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# From your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The mailbox the SYSTEM sends from (it has to log in to some mailbox to send). Gmail address + an App Password
# (not your normal Gmail password — generate one at myaccount.google.com/apppasswords)
EMAIL_USER=
EMAIL_APP_PASSWORD=

# OPTIONAL extra recipient(s) for system emails, comma-separated. Backups and alerts already go to
# the email of every OWNER account, so this can stay empty. Use it only for a shared inbox.
OWNER_EMAIL=

PORT=5000

# The website + admin dashboard addresses allowed to call this API, comma-separated,
# no trailing slashes. Example: https://manik.com,https://admin.manik.com
# (If left empty the API accepts requests from any site — fine for local dev only.)
CORS_ORIGINS=

# A long random string only your automatic-backup GitHub Action knows.
# Generate one the same way as JWT_SECRET above.
BACKUP_SECRET=
# (at least 16 characters; JWT_SECRET must also be at least 16 characters)

# Number of proxies in front of the app (1 normally; 2 when the admin forwards /api through Vercel to Render)
TRUST_PROXY=1
# Set to production on the live server
# NODE_ENV=production   (uncomment on the live server only; leave unset when developing locally)

# --- Keep-alive (stops a free Render service from sleeping) ---
# Turns on by itself in production on Render. Only set these to change the default.
# KEEP_ALIVE=off               (use on a paid plan that never sleeps)
# KEEP_ALIVE_URL=https://manik-backend-re8v.onrender.com
# KEEP_ALIVE_MINUTES=10
